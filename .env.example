# Copy to .env for local development. Never commit .env.

# PostgreSQL connection string (Supabase: Project → Connect → Transaction pooler, port 6543).
# On Vercel, the Supabase integration sets POSTGRES_URL automatically — either name works.
# Leave empty to use local SQLite (storage/createza.sqlite), or /tmp demo mode on Vercel.
DATABASE_URL=

# Password for the seeded demo accounts (used only when the database is first seeded).
DEMO_PASSWORD=CreateZA-demo-2026

# Build the schema and load demo data automatically on first use
DB_AUTO_SETUP=true

# SQLite file when DATABASE_URL is empty
DB_PATH=storage/createza.sqlite

# Max size per uploaded file in MB (Vercel's request limit is 4.5 MB, so keep ≤ 4 there)
UPLOAD_MAX_MB=4

APP_TIMEZONE=Africa/Johannesburg
