# Copy to .env and adjust. Never commit .env.

# production | local
APP_ENV=local
# true shows error details in the browser — keep false in production
APP_DEBUG=false
APP_TIMEZONE=Africa/Johannesburg

# SQLite database file, relative to the project root (or an absolute path)
DB_PATH=storage/createza.sqlite
# PostgreSQL instead of SQLite (Vercel + Neon sets this automatically). Leave empty for SQLite.
DATABASE_URL=
# local = public/uploads on disk, database = store uploads in the database (serverless hosts)
UPLOAD_DRIVER=local
# Build the schema and load demo data automatically when the database file doesn't exist yet
DB_AUTO_SETUP=true

# Password given to the seeded demo accounts. Change it, and change the accounts, before going live.
DEMO_PASSWORD=CreateZA-demo-2026

# Maximum size of each uploaded file in MB (PHP's upload_max_filesize / post_max_size must allow it too)
UPLOAD_MAX_MB=50

# Set to true when the site is served over HTTPS so the session cookie is marked Secure
SESSION_SECURE=false
