---
import Icon from './Icon.astro';

interface Props {
  eyebrow: string;
  heading: string;
  intro?: string;
  link?: [string, string];
}
const { eyebrow, heading, intro, link } = Astro.props;
---
<div class="section-head">
  <div>
    <p class="eyebrow">{eyebrow}</p>
    <h2>{heading}</h2>
  </div>
  {intro && <p class="section-head__intro muted">{intro}</p>}
  {link && <a class="link-arrow" href={link[0]}>{link[1]} <Icon name="arrow-right" /></a>}
</div>
