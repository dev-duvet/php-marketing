---
import EventCard from '../components/EventCard.astro';
import Icon from '../components/Icon.astro';
import MediaCard from '../components/MediaCard.astro';
import ProductCard from '../components/ProductCard.astro';
import SectionHead from '../components/SectionHead.astro';
import Socials from '../components/Socials.astro';
import PublicLayout from '../layouts/PublicLayout.astro';
import { SERVICES, serviceName } from '../lib/catalog.ts';
import { all } from '../lib/db.ts';
import { mediaUrl } from '../lib/format.ts';

const featured = Object.entries(SERVICES).slice(0, 4);
const [gallery, work, products, events] = await Promise.all([
  all('SELECT * FROM assets WHERE public_category IS NOT NULL ORDER BY id DESC LIMIT 9'),
  all('SELECT * FROM projects WHERE is_public = 1 ORDER BY due_date DESC LIMIT 3'),
  all('SELECT * FROM products WHERE is_active = 1 ORDER BY id LIMIT 4'),
  all('SELECT * FROM events WHERE starts_at >= now_local() ORDER BY starts_at LIMIT 3'),
]);
---
<PublicLayout title="Creative work made to move">
  <section class="hero container">
    <div class="hero__copy">
      <h1 class="display">Creative work<br />made to move<span class="accent">.</span></h1>
      <p class="lead">Photography. Video. Websites. Social content.<br />Creative media for bold ideas and bigger stories.</p>
      <div class="button-row">
        <a class="btn btn--navy" href="/contact">Start a project <Icon name="arrow-right" /></a>
        <a class="btn btn--text" href="/gallery?category=video"><span class="play-ring"><Icon name="play" /></span> Watch showreel</a>
      </div>
    </div>
    <div class="hero__collage" aria-hidden="true">
      <span class="block block--red"></span>
      <span class="block block--navy"></span>
      <span class="block block--gold"></span>
      <img class="c1" src="/assets/media/hero-camera.jpg" alt="" />
      <img class="c2" src="/assets/media/hero-session.jpg" alt="" />
      <img class="c3" src="/assets/media/websites.jpg" alt="" />
      <img class="c4" src="/assets/media/hero-street.jpg" alt="" />
      <img class="c5" src="/assets/media/hero-creator.jpg" alt="" />
    </div>
  </section>

  <section class="container">
    <div class="ribbon">
      <strong>Follow the creative journey</strong>
      <Socials />
      <span class="ribbon__note muted small">Creative content. Real moments.<br />Across every platform.</span>
    </div>
  </section>

  <section class="section container">
    <SectionHead eyebrow="Services" heading="What we do" intro="End-to-end creative media services to help you tell your story, connect your audience and create meaningful impact." link={['/services', 'Explore all services']} />
    <div class="grid grid--4">
      {featured.map(([slug, service]) => (
        <article class="service-card">
          <img src={`/${service.image}`} alt="" loading="lazy" />
          <div class="service-card__body">
            <h3>{service.name}</h3>
            <p class="muted">{service.summary}</p>
            <a class="link-arrow" href={`/services#${slug}`}>Learn more <Icon name="arrow-right" /></a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section container">
    <SectionHead eyebrow="Gallery" heading="Social content" intro="A mix of photography, video and creative content from recent work and behind the scenes." link={['/gallery', 'View full gallery']} />
    <div class="mosaic">
      {gallery.map((item) => <MediaCard item={item} />)}
    </div>
  </section>

  <section class="section container">
    <SectionHead eyebrow="Work" heading="Selected work" intro="A closer look at some of our recent creative projects across photo, video, web and social." link={['/work', 'View all work']} />
    <div class="grid grid--3">
      {work.map((project) => (
        <a class="work-card" href={`/work/${project.slug}`}>
          <img src={mediaUrl(project.cover_image)} alt="" loading="lazy" />
          <span class="chip">{serviceName(project.service_type)}</span>
          <strong>{project.name}</strong>
        </a>
      ))}
    </div>
  </section>

  <section class="section section--navy">
    <div class="container split">
      <div>
        <p class="eyebrow eyebrow--light">Community</p>
        <h2>Made with creators, for creators.</h2>
        <p class="lead">CreateZA is creator-led. We run shoots, workshops and meetups that help new photographers, filmmakers and storytellers grow — and we bring that energy to every client project.</p>
        <div class="button-row">
          <a class="btn btn--primary" href="/events">See upcoming events</a>
          <a class="btn btn--outline-light" href="/about">Our story</a>
        </div>
      </div>
      <img class="split__img" src="/assets/media/community.jpg" alt="A group of young creators smiling together" loading="lazy" />
    </div>
  </section>

  <section class="section container">
    <SectionHead eyebrow="Store" heading="Creative goods" intro="Branded essentials for everyday creatives." link={['/store', 'Visit store']} />
    <div class="grid grid--4">
      {products.map((product) => <ProductCard product={product} />)}
    </div>
  </section>

  <section class="section container">
    <SectionHead eyebrow="Events" heading="Upcoming events" intro="Creative meetups, shoots, workshops and community events." link={['/events', 'View all events']} />
    <div class="grid grid--3">
      {events.map((event) => <EventCard event={event} />)}
      {events.length === 0 && <p class="muted">New events are announced soon.</p>}
    </div>
  </section>

  <section class="section container">
    <div class="cta">
      <div>
        <h2>Let’s create together.</h2>
        <p class="muted">Have a project in mind? Tell us about it and we’ll come back with ideas, timelines and a quote.</p>
      </div>
      <a class="btn btn--primary" href="/contact">Start a project <Icon name="arrow-right" /></a>
    </div>
  </section>
</PublicLayout>
